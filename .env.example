# Sao chép file này thành .env.local rồi điền giá trị thật — không commit .env.local.

# Lấy ở Supabase Dashboard > Project Settings > API.
# LƯU Ý: SUPABASE_SERVICE_ROLE_KEY không có tiền tố NEXT_PUBLIC_ — chỉ dùng ở
# server (src/infra/supabase/server-client.ts), không bao giờ gửi ra client.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Trang quản trị không còn nằm ở web này nữa — xem project riêng
# PASS_PHONG_ADMIN (chạy local, dùng chung Supabase project ở trên, có tài
# khoản admin riêng thay vì 1 mã bí mật dùng chung).

# URL công khai của site — dùng để tạo absolute URL cho ảnh Open Graph khi
# chia sẻ link vào group Facebook. Khi deploy Vercel, đặt bằng domain thật.
SITE_URL=http://localhost:3000
